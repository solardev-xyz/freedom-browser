+    params: PPv2PluginParameters,
+    config: DeriveFromSignatureConfig,
+): Promise<Hex> {
+    const gapLimit = params.revocableKeyGapLimit ?? 20;
+    if (!params.deployment || !Number.isInteger(gapLimit) || gapLimit < 1 || gapLimit > 256) {
+        throw new Error("Unsupported rotation recovery configuration");
+    }
