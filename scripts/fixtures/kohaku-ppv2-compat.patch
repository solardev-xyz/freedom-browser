+        rpcInteractor: new KohakuRpcInteractor(host.provider),
+        contractAddress: params.deployment.keystoreAddress,
+        ...(params.deploymentBlock !== undefined ? { deploymentBlock: BigInt(params.deploymentBlock) } : {}),
+    });
+    const currentDigest = await interactor.getCurrentAuthorizerDigest(params.ownerAddress as Address);
+    if (currentDigest === null) throw new Error("Registered owner has no auth policy history");
+    const cryptoService = new CryptoService();
+    const hashService = await PoseidonHashService.create();
