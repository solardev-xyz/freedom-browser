# Real-conditions E2E of each published release candidate and release.
# Installed by scripts/nightly-vm-e2e/install-timer.sh.
[Unit]
Description=Freedom release real-conditions E2E (clean Ubuntu + Windows VMs)
After=libvirtd.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
SupplementaryGroups=libvirt
ExecStart=@BIN@/run-nightly.sh --release latest
TimeoutStartSec=4h
