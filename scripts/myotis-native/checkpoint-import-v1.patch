+/// Freedom extension: bootstrap only from the host-authenticated root. Existing
+/// snapshots are refused unless the host confirms the same owned generation.
+pub fn create_with_checkpoint(network_name: &str, data_dir: &str, root: &str, slot: u64, resume_verified_state: bool) -> i64 {
+    let Some(mut config) = config_for(network_name) else { return CREATE_FAILED; };
+    if !matches!(config.name, "mainnet" | "gnosis") { return UNSUPPORTED_NETWORK; }
+    let Some(root) = parse_hex_fixed::<32>(root) else { return CREATE_FAILED; };
+    let Ok(elapsed) = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH) else { return CREATE_FAILED; };
+    let wall_slot = elapsed.as_secs().saturating_sub(config.genesis_time) / config.seconds_per_slot;
+    if root == [0; 32] || slot == 0 || slot > 9_007_199_254_740_991
+        || slot > wall_slot || !std::path::Path::new(data_dir).is_absolute() {
+        return CREATE_FAILED;
+    }
+    let snapshot = if config.name == "mainnet" { "sync-state.snapshot" } else { "sync-state-gnosis.snapshot" };
+    if !resume_verified_state && std::fs::symlink_metadata(std::path::Path::new(data_dir).join(snapshot)).is_ok() {
+        return CREATE_FAILED;
+    }
+    config.checkpoint_root = root;
+    config.checkpoint_slot = slot;
+    create_config(config, data_dir)
+}
